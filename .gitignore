# Rust / Cargo (keep Cargo.lock tracked for reproducible builds)
/target/
**/*.rs.bk
*.profraw
*.profdata

# Local application data and personal files
/local-data/
.perso

# Local editor and agent settings
/.vscode/
/.idea/
/.codex/

# Local environment settings (keep distributable examples)
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Logs, crash dumps and temporary files
*.log
*.dmp
*.stackdump
*.swp
*.swo
*~
*.tmp
*.temp
*.bak
*.orig
*.rej

# Operating system metadata
Thumbs.db
desktop.ini
$RECYCLE.BIN/
.DS_Store
._*
